# Copy to `.env.local` and fill in. Do not commit `.env.local` (see .gitignore).
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Backend API origin — must match the Flutter REST/WebSocket environment.
# development: http://127.0.0.1:8000
# staging/production: https://braelo-v1-bdaqhdc4c7d9fdb7.canadacentral-01.azurewebsites.net
NEXT_PUBLIC_API_URL=https://braelo-v1-bdaqhdc4c7d9fdb7.canadacentral-01.azurewebsites.net

# Google Maps JavaScript API (enable Maps JavaScript API, Places, Geocoding in Google Cloud)
# Use either line (the app checks both):
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_API_KEY=
